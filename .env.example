# Pengembangan lokal saja. File contoh ini tidak dimuat otomatis.
# Variabel SQL hanya dipasang pada proses PosServer/PosSetup, bukan WPF.
POS_CONNECTION_STRING=Server=localhost;Database=PosDesktop;Integrated Security=true;Encrypt=true;TrustServerCertificate=true
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://127.0.0.1:5077
POS_API_ALLOW_HTTP_DEV=true
# WPF memakai alamat API; tidak memakai POS_CONNECTION_STRING.
POS_API_URL=http://127.0.0.1:5077/
