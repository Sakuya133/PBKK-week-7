# Set these variables only on the API host. Never put a real secret in this example file.
POS_CONNECTION_STRING=Server=localhost;Database=PosDesktop;User ID=pos_api;Password=CHANGE_ME;Encrypt=true;TrustServerCertificate=false
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=https://0.0.0.0:8443

# Development only, when API is local and loopback-only:
# ASPNETCORE_ENVIRONMENT=Development
# POS_API_ALLOW_HTTP_DEV=true
# ASPNETCORE_URLS=http://127.0.0.1:5077
