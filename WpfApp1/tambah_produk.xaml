<Window x:Class="WpfApp1.tambah_produk"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tambah Produk" Height="320" Width="550"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F8F9FA">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Tambah Produk" FontSize="18" FontWeight="Bold" Foreground="#333333" Margin="0,0,0,15"/>

        <Grid Grid.Row="1" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Top">
                <Border Width="120" Height="120" CornerRadius="8" BorderBrush="#DDDDDD" BorderThickness="1.5" Background="#FFFFFF" ClipToBounds="True">
                   
                    <Image x:Name="ImgPreview" Stretch="UniformToFill" Source="/foto/putih.jpeg"/>
                </Border>
                <Button x:Name="BtnTambahFoto" Content="Tambah Foto" Margin="0,10,0,0" Width="100" Height="28"
                        Background="#0275D8" Foreground="White" FontWeight="SemiBold" BorderThickness="0"
                        Click="BtnTambahFoto_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>

            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                <TextBlock Text="Nama Produk" FontSize="12" Foreground="#666666" Margin="0,0,0,4" FontWeight="SemiBold"/>
                <TextBox x:Name="TxtNamaProduk" Padding="8,6" Margin="0,0,0,12" FontSize="14"
                         BorderBrush="#CCCCCC" BorderThickness="1">
                    <TextBox.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </TextBox.Resources>
                </TextBox>

                <!-- Input Harga Produk -->
                <TextBlock Text="Harga Produk (Rp)" FontSize="12" Foreground="#666666" Margin="0,0,0,4" FontWeight="SemiBold"/>
                <TextBox x:Name="TxtHargaProduk" Padding="8,6" Margin="0,0,0,10" FontSize="14"
                         BorderBrush="#CCCCCC" BorderThickness="1">
                    <TextBox.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </TextBox.Resources>
                </TextBox>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Batal" Width="80" Height="32" Margin="0,0,10,0" 
                    Background="#FFFF8585" Foreground="#333333" BorderThickness="0"
                    Click="BtnBatal_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="4"/>
                    </Style>
                </Button.Resources>
            </Button>
            <Button Content="Simpan" Width="90" Height="32" 
                    Background="#FF18825A" Foreground="White" FontWeight="SemiBold" BorderThickness="0"
                    Click="BtnSimpan_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="4"/>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
</Window>