<Window x:Class="WpfApp1.kategori_admin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kategori Admin - GACOANNNN"
        Height="650" Width="1000"
        MinHeight="550" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="#F4F7FB">

    <Window.Resources>
        <Style x:Key="MenuButton" TargetType="Button">
            <Setter Property="Height" Value="43"/>
            <Setter Property="Margin" Value="12,4"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Foreground" Value="#E8EEF5"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="MenuBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10">
                            <ContentPresenter
                                Margin="{TemplateBinding Padding}"
                                VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="MenuBorder"
                                        Property="Background"
                                        Value="#344B61"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Padding" Value="13,7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR BIRU TUA -->
        <Border Grid.Column="0" Background="#243447" Margin="0,0,10,0">
            <DockPanel LastChildFill="True">

                <StackPanel DockPanel.Dock="Top"
                            Margin="20,25,20,25">
                    <TextBlock Text="WARUNG POS"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="White"/>

                    <TextBlock Text="Admin"
                               FontSize="12"
                               Foreground="#AEBECD"
                               Margin="0,5,0,0"/>
                </StackPanel>

                <StackPanel>
                    <TextBlock Text="MENU UTAMA"
                               Foreground="#8FA2B6"
                               FontSize="10"
                               FontWeight="Bold"
                               Margin="24,0,0,10"/>

                    <Button Content="▦   Dashboard"
                            Style="{StaticResource MenuButton}"/>

                    <Button Content="▣   Kasir"
                            Style="{StaticResource MenuButton}"/>

                    <Button Content="▤   Kategori"
                            Style="{StaticResource MenuButton}"
                            Background="#3B5872"/>

                    <Button Content="▧   Produk"
                            Style="{StaticResource MenuButton}"/>

                    <Button Content="▥   Penjualan"
                            Style="{StaticResource MenuButton}"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom"
                            Margin="20,20,20,25">
                    <Separator Background="#45586B"
                               Margin="0,0,0,12"/>

                </StackPanel>

            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,22">
                <TextBlock Text="Kelola Kategori"
                           FontSize="27"
                           FontWeight="Bold"
                           Foreground="#1F2D3D"/>

                <TextBlock
                    Text="Atur kategori produk yang tersedia di GACOANNNN."
                    FontSize="13"
                    Foreground="#788797"
                    Margin="0,6,0,0"/>
            </StackPanel>

            <Grid Grid.Row="1" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Height="42"
                        Background="White"
                        CornerRadius="9"
                        BorderBrush="#E0E7EF"
                        BorderThickness="1"
                        MaxWidth="700"
                        HorizontalAlignment="Left">

                    <TextBox Text="Cari kategori..."
                             BorderThickness="0"
                             Background="Transparent"
                             VerticalContentAlignment="Center"
                             Margin="12,0"
                             Width="550"
                             Foreground="#788797"/>
                </Border>

                <Button Grid.Column="1"
                        Content="+ Tambah Kategori"
                        Background="#2F765B"
                        Foreground="White"
                        FontWeight="SemiBold"
                        Padding="16,10"
                        BorderThickness="0"
                        Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="9"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <Grid Grid.Row="2" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="White"
                        CornerRadius="11"
                        Padding="14"
                        Margin="0,0,8,0"
                        BorderBrush="#E3EAF1"
                        BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="TOTAL KATEGORI"
                                   FontSize="10"
                                   Foreground="#8291A1"/>
                        <TextBlock Text="4"
                                   FontSize="25"
                                   FontWeight="Bold"
                                   Foreground="#243447"
                                   Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1"
                        Background="White"
                        CornerRadius="11"
                        Padding="14"
                        Margin="4,0"
                        BorderBrush="#E3EAF1"
                        BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="KATEGORI AKTIF"
                                   FontSize="10"
                                   Foreground="#8291A1"/>
                        <TextBlock Text="4"
                                   FontSize="25"
                                   FontWeight="Bold"
                                   Foreground="#2F765B"
                                   Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2"
                        Background="White"
                        CornerRadius="11"
                        Padding="14"
                        Margin="8,0,0,0"
                        BorderBrush="#E3EAF1"
                        BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="TOTAL PRODUK"
                                   FontSize="10"
                                   Foreground="#8291A1"/>
                        <TextBlock Text="18"
                                   FontSize="25"
                                   FontWeight="Bold"
                                   Foreground="#4D89B5"
                                   Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <ScrollViewer Grid.Row="3"
                          VerticalScrollBarVisibility="Auto">

                <StackPanel>
                    <TextBlock Text="Daftar Kategori"
                               FontSize="17"
                               FontWeight="Bold"
                               Foreground="#263748"
                               Margin="0,0,0,13"/>

                    <UniformGrid Columns="2">

                        <Border Background="White"
                                CornerRadius="13"
                                Padding="16"
                                Margin="0,0,8,12"
                                BorderBrush="#E3EAF1"
                                BorderThickness="1">
                            <StackPanel>
                                <Border Width="46"
                                        Height="46"
                                        Background="#FFF0E4"
                                        CornerRadius="11"
                                        HorizontalAlignment="Left">
                                    <TextBlock Text="🍜"
                                               FontSize="25"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>

                                <TextBlock Text="Mie"
                                           FontSize="17"
                                           FontWeight="Bold"
                                           Foreground="#263748"
                                           Margin="0,12,0,4"/>

                                <TextBlock Text="8 produk"
                                           FontSize="12"
                                           Foreground="#8492A1"/>

                                <StackPanel Orientation="Horizontal"
                                            Margin="0,15,0,0">
                                    <Button Content="Edit"
                                            Background="#E8F0F7"
                                            Foreground="#315B7D"
                                            Style="{StaticResource ActionButton}"
                                            Margin="0,0,8,0"/>

                                    <Button Content="Hapus"
                                            Background="#FCEAEA"
                                            Foreground="#B74747"
                                            Style="{StaticResource ActionButton}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Background="White"
                                CornerRadius="13"
                                Padding="16"
                                Margin="4,0,0,12"
                                BorderBrush="#E3EAF1"
                                BorderThickness="1">
                            <StackPanel>
                                <Border Width="46"
                                        Height="46"
                                        Background="#E5F3FF"
                                        CornerRadius="11"
                                        HorizontalAlignment="Left">
                                    <TextBlock Text="🥤"
                                               FontSize="25"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>

                                <TextBlock Text="Minuman"
                                           FontSize="17"
                                           FontWeight="Bold"
                                           Foreground="#263748"
                                           Margin="0,12,0,4"/>

                                <TextBlock Text="5 produk"
                                           FontSize="12"
                                           Foreground="#8492A1"/>

                                <StackPanel Orientation="Horizontal"
                                            Margin="0,15,0,0">
                                    <Button Content="Edit"
                                            Background="#E8F0F7"
                                            Foreground="#315B7D"
                                            Style="{StaticResource ActionButton}"
                                            Margin="0,0,8,0"/>

                                    <Button Content="Hapus"
                                            Background="#FCEAEA"
                                            Foreground="#B74747"
                                            Style="{StaticResource ActionButton}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Background="White"
                                CornerRadius="13"
                                Padding="16"
                                Margin="0,0,8,12"
                                BorderBrush="#E3EAF1"
                                BorderThickness="1">
                            <StackPanel>
                                <Border Width="46"
                                        Height="46"
                                        Background="#E7F6EC"
                                        CornerRadius="11"
                                        HorizontalAlignment="Left">
                                    <TextBlock Text="🍟"
                                               FontSize="25"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>

                                <TextBlock Text="Gorengan"
                                           FontSize="17"
                                           FontWeight="Bold"
                                           Foreground="#263748"
                                           Margin="0,12,0,4"/>

                                <TextBlock Text="3 produk"
                                           FontSize="12"
                                           Foreground="#8492A1"/>

                                <StackPanel Orientation="Horizontal"
                                            Margin="0,15,0,0">
                                    <Button Content="Edit"
                                            Background="#E8F0F7"
                                            Foreground="#315B7D"
                                            Style="{StaticResource ActionButton}"
                                            Margin="0,0,8,0"/>

                                    <Button Content="Hapus"
                                            Background="#FCEAEA"
                                            Foreground="#B74747"
                                            Style="{StaticResource ActionButton}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Background="White"
                                CornerRadius="13"
                                Padding="16"
                                Margin="4,0,0,12"
                                BorderBrush="#E3EAF1"
                                BorderThickness="1">
                            <StackPanel>
                                <Border Width="46"
                                        Height="46"
                                        Background="#F3E9FF"
                                        CornerRadius="11"
                                        HorizontalAlignment="Left">
                                    <TextBlock Text="🍰"
                                               FontSize="25"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>

                                <TextBlock Text="Kue"
                                           FontSize="17"
                                           FontWeight="Bold"
                                           Foreground="#263748"
                                           Margin="0,12,0,4"/>

                                <TextBlock Text="2 produk"
                                           FontSize="12"
                                           Foreground="#8492A1"/>

                                <StackPanel Orientation="Horizontal"
                                            Margin="0,15,0,0">
                                    <Button Content="Edit"
                                            Background="#E8F0F7"
                                            Foreground="#315B7D"
                                            Style="{StaticResource ActionButton}"
                                            Margin="0,0,8,0"/>

                                    <Button Content="Hapus"
                                            Background="#FCEAEA"
                                            Foreground="#B74747"
                                            Style="{StaticResource ActionButton}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                    </UniformGrid>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
