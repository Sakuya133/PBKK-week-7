<Window x:Class="WpfApp1.Penjualan"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Penjualan - WARUNG POS"
        Height="680" Width="1100"
        MinHeight="560" MinWidth="850"
        WindowStartupLocation="CenterScreen"
        Background="#F4F7FB">

    <Window.Resources>
        <Style x:Key="MenuButton" TargetType="Button">
            <Setter Property="Height" Value="43"/>
            <Setter Property="Margin" Value="12,4"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Foreground" Value="#E8EEF5"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="MenuBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="MenuBorder"
                                        Property="Background"
                                        Value="#344B61"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F4F7FB"/>
            <Setter Property="Foreground" Value="#526477"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,12"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#E3EAF1"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0"
                Background="#243447"
                Margin="0,0,10,0">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top"
                            Margin="20,25,20,25">
                    <TextBlock Text="WARUNG POS"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="White"/>
                    <TextBlock Text="Admin"
                               FontSize="12"
                               Foreground="#AEBECD"
                               Margin="0,5,0,0"/>
                </StackPanel>

                <StackPanel>
                    <TextBlock Text="MENU UTAMA"
                               Foreground="#8FA2B6"
                               FontSize="10"
                               FontWeight="Bold"
                               Margin="24,0,0,10"/>

                    <Button Content="▦   Dashboard"
                            Style="{StaticResource MenuButton}"/>
                    <Button Content="▣   Kasir"
                            Style="{StaticResource MenuButton}"/>
                    <Button Content="▤   Kategori"
                            Style="{StaticResource MenuButton}"
                            Click="Kategori_Click"/>
                    <Button Content="▧   Produk"
                            Style="{StaticResource MenuButton}"
                            Click="Produk_Click"/>
                    <Button Content="▥   Penjualan"
                            Style="{StaticResource MenuButton}"
                            Background="#3B5872"/>
                </StackPanel>

            </DockPanel>
        </Border>

        <!-- Main content -->
        <Grid Grid.Column="1" Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="Riwayat Penjualan"
                           FontSize="27"
                           FontWeight="Bold"
                           Foreground="#1F2D3D"/>
                <TextBlock Text="Lihat transaksi yang telah tercatat."
                           FontSize="13"
                           Foreground="#788797"
                           Margin="0,6,0,0"/>
                <TextBlock Text="MODE DEMO • Data contoh, bukan data database"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="#A66A16"
                           Margin="0,8,0,0"/>
            </StackPanel>
            
            <!-- Summary cards -->
            <Grid Grid.Row="1" Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Transactions Card -->
                <Border Grid.Column="0"
                        Background="White"
                        CornerRadius="11"
                        Padding="16"
                        Margin="0,0,6,0"
                        BorderBrush="#E3EAF1"
                        BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="TRANSAKSI DI HALAMAN"
                                FontSize="10"
                                Foreground="#8291A1"/>
                        <TextBlock Text="{Binding ElementName=TransactionsGrid, Path=Items.Count}"
                                FontSize="24"
                                FontWeight="Bold"
                                Foreground="#243447"
                                Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Page Card -->
                <Border Grid.Column="1"
                        Background="White"
                        CornerRadius="11"
                        Padding="16"
                        Margin="6,0,0,0"
                        BorderBrush="#E3EAF1"
                        BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="HALAMAN"
                                FontSize="10"
                                Foreground="#8291A1"/>
                        <TextBlock Text="{Binding ElementName=PageInfo, Path=Text}"
                                FontSize="24"
                                FontWeight="Bold"
                                Foreground="#4D89B5"
                                Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>


            <!-- Toolbar -->
            <Grid Grid.Row="2" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Daftar Transaksi"
                           FontSize="17"
                           FontWeight="Bold"
                           Foreground="#263748"
                           VerticalAlignment="Center"/>

                <Button Grid.Column="1"
                        Content="↻  Refresh"
                        Click="Refresh_Click"
                        Background="#2F765B"
                        Foreground="White"
                        Style="{StaticResource ActionButton}"/>
            </Grid>

            <!-- Transaction table -->
            <Border Grid.Row="3"
                    Background="White"
                    CornerRadius="12"
                    BorderBrush="#E3EAF1"
                    BorderThickness="1"
                    Padding="8">
                <DataGrid x:Name="TransactionsGrid"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserResizeRows="False"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#EDF1F5"
                          HeadersVisibility="Column"
                          Background="White"
                          BorderThickness="0"
                          RowHeight="44"
                          ColumnHeaderHeight="42"
                          SelectionChanged="TransactionsGrid_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="No. Transaksi"
                                            Binding="{Binding Number}"
                                            Width="1.6*"/>
                        <DataGridTextColumn Header="Tanggal"
                                            Binding="{Binding CreatedAt, StringFormat={}{0:dd/MM/yyyy HH:mm}}"
                                            Width="1.5*"/>
                        <DataGridTextColumn Header="Kasir"
                                            Binding="{Binding CashierName}"
                                            Width="1.1*"/>
                        <DataGridTextColumn Header="Pembayaran"
                                            Binding="{Binding PaymentMethod}"
                                            Width="1.1*"/>
                        <DataGridTextColumn Header="Total (Rp)"
                                            Binding="{Binding Total, StringFormat={}{0:N0}}"
                                            Width="1.2*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Status and pagination -->
            <Grid Grid.Row="4" Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock x:Name="StatusText"
                               Foreground="#687386"
                               TextWrapping="Wrap"
                               Margin="0,0,8,0"/>
                    <TextBlock x:Name="PageInfo"
                               Text="Halaman 1"
                               Foreground="#8291A1"
                               FontSize="11"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button x:Name="PreviousButton"
                            Content="Sebelumnya"
                            Click="Previous_Click"
                            IsEnabled="False"
                            Background="#E8F0F7"
                            Foreground="#315B7D"
                            Style="{StaticResource ActionButton}"
                            Margin="0,0,8,0"/>

                    <Button x:Name="NextButton"
                            Content="Selanjutnya"
                            Click="Next_Click"
                            IsEnabled="False"
                            Background="#E8F0F7"
                            Foreground="#315B7D"
                            Style="{StaticResource ActionButton}"
                            Margin="0,0,8,0"/>

                    <Button x:Name="DetailButton"
                            Content="Lihat Detail"
                            Click="Detail_Click"
                            IsEnabled="False"
                            Background="#2F765B"
                            Foreground="White"
                            Style="{StaticResource ActionButton}"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
