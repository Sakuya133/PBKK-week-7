# Simpan sebagai environment/secret pada host server, bukan dalam repo atau paket WPF.
POS_CONNECTION_STRING=Server=tcp:sql.example.com,1433;Database=PosDesktop;Integrated Security=true;Encrypt=true;TrustServerCertificate=false
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=https://0.0.0.0:8443
# Konfigurasikan sertifikat Kestrel yang dipercaya klien melalui secret host.
# Contoh nama variabel: ASPNETCORE_Kestrel__Certificates__Default__Path dan __Password.
# WPF hanya memakai alamat API publik, misalnya https://pos.example.com:8443/.
